# ===============================================
# CrimeVision - Environment Configuration Template
# Copy this file to .env and configure your values
# ===============================================

# AWS Credentials (Optional if configured via AWS CLI 'aws configure')
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# AWS_DEFAULT_REGION=us-east-1

# AWS Resource Names
AWS_REGION=us-east-1
S3_BUCKET_NAME=criminal-images-bucket
S3_PREFIX=criminals/
REKOGNITION_COLLECTION_ID=criminal_collection
DYNAMODB_TABLE_NAME=criminal_records

# Matching Parameters
MATCH_CONFIDENCE_THRESHOLD=80.0
MAX_FACES_TO_MATCH=5
